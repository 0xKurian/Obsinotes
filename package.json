{
  "name": "obsinotes",
  "version": "1.0.0",
  "description": "Multi-page digital whiteboard and notebook with stylus inking, paper templates, sticky notes, LaTeX, and Goodnotes-like continuous scrolling for Obsidian.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "node esbuild.config.mjs production",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/**/*.test.ts"
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "handwriting",
    "digital-ink",
    "goodnotes",
    "notebook"
  ],
  "author": "Vinh-Hung",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.12.7",
    "builtin-modules": "^3.3.0",
    "esbuild": "^0.21.1",
    "obsidian": "latest",
    "tslib": "^2.6.2",
    "tsx": "^4.23.15",
    "typescript": "^5.4.5"
  },
  "dependencies": {
    "pdf-lib": "^1.17.1",
    "perfect-freehand": "^1.2.3"
  }
}
